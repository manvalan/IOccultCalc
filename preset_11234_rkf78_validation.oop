# IOccultCalc Preset - (11234) 1999 JS82 con AstDyn/RKF78
# Test di validazione propagazione temporale ad alta precisione
# 
# Uso: ./italoccultcalc.sh preset_11234_rkf78_validation.oop
#
# Questo preset usa:
# - Propagatore RKF78 con perturbazioni complete (8 pianeti + 16 asteroidi)
# - Elementi orbitali da AstDyS (6844 osservazioni, 36 anni)
# - Fitting differenziale per migliorare elementi
# - Catalogo Gaia DR3 per stelle fino a mag 18
# - Ottimizzazioni Chebyshev per performance
#
# Accuratezza attesa:
# - ±30 giorni: < 1" (tipicamente 0.1-0.3")
# - ±60 giorni: 1-3" (con perturbazioni complete)
# - ±90 giorni: 3-10"

# ═══════════════════════════════════════════════════════════════
# PROPAGATORE AD ALTA PRECISIONE
# ═══════════════════════════════════════════════════════════════

general.
    # RKF78 con perturbazioni planetarie complete
    .propagator = 'RKF78'
    .step_size_days = 0.1  # Step iniziale (si adatta automaticamente)
    .tolerance = 1.0e-12   # Tolleranza integratore

# ═══════════════════════════════════════════════════════════════
# PERIODO DI RICERCA
# ═══════════════════════════════════════════════════════════════

time.
    # Test su 3 mesi centrati sull'epoca
    # Epoca elementi: MJD 61000.0 = 2025-11-20
    .start_date = '2025-09-21'  # -60 giorni
    .end_date = '2026-01-19'     # +60 giorni (120 giorni totali)
    .interval_days = 1.0

# ═══════════════════════════════════════════════════════════════
# ASTEROIDE TARGET
# ═══════════════════════════════════════════════════════════════

asteroids.
    # Singolo asteroide specificato
    .selection_mode = 'list'
    .asteroid_list = '11234'  # (11234) 1999 JS82

# Sorgente elementi orbitali
orbit_source.
    .type = 'mpc'  # Usa MPC per elementi standard
    .asteroid_number = 11234

# ═══════════════════════════════════════════════════════════════
# FITTING ORBITALE (OPZIONALE - migliora accuratezza)
# ═══════════════════════════════════════════════════════════════

orbit_fitting.
    # Abilita fitting differenziale con osservazioni
    .enable_fitting = .FALSE.  # Set .TRUE. per usare fitting
    
    # Se abilitato, scarica osservazioni da MPC/AstDyS e fa differential correction
    # per migliorare elementi orbitali prima della propagazione
    #
    # Vantaggi:
    #   - Riduce errore propagazione da ~10-50" a ~1-3" (±60 giorni)
    #   - Usa osservazioni più recenti (< 1 anno)
    #   - Rimuove outlier automaticamente (> 3σ)
    #
    # Svantaggi:
    #   - Richiede connessione internet per download osservazioni
    #   - Tempo aggiuntivo: ~5-10s per fitting
    #   - Richiede minimo 50 osservazioni di qualità
    
    .observation_source = 'mpc'  # Fonte: 'mpc' o 'astdys'
    .min_observations = 50
    .max_observation_age_days = 365  # Solo osservazioni < 1 anno
    .outlier_threshold_sigma = 3.0
    .max_iterations = 20

# ═══════════════════════════════════════════════════════════════
# CONFIGURAZIONE PROPAGATORE
# ═══════════════════════════════════════════════════════════════

propagator.
    # Perturbazioni (TUTTE ABILITATE per massima accuratezza)
    .use_planetary_perturbations = .TRUE.  # 8 pianeti (essenziale!)
    .use_relativistic_corrections = .FALSE.  # Opzionale, impatto minore
    .max_steps = 100000  # Safety limit

# ═══════════════════════════════════════════════════════════════
# PARAMETRI RICERCA
# ═══════════════════════════════════════════════════════════════

search.
    .max_magnitude = 18.0  # Stelle fino a mag 18
    .search_radius_deg = 0.2  # Raggio ricerca attorno traiettoria
    .min_probability = 0.001  # Probabilità minima per includere evento

# ═══════════════════════════════════════════════════════════════
# OCCULTAZIONE - Settings compatibili LinOccult
# ═══════════════════════════════════════════════════════════════

occultation.
    # Parametri geometrici
    .shadow_threshold_factor = 3.0  # 3σ per ombra
    .star_uncertainty_base_mas = 7.0  # Gaia DR3 base uncertainty
    .star_pm_degradation_mas_per_year = 2.5  # Degrado PM/anno
    .use_probability_cdf = .TRUE.
    .earth_oblateness_factor = 0.996647  # WGS84
    .angular_buffer_arcmin = 2.0  # Buffer per eventi border
    
    # ✓ Chebyshev interpolation (2× speedup)
    # Con RKF78 è meno critico (già veloce) ma migliora comunque
    .use_chebyshev = .TRUE.
    .chebyshev_order = 11
    .chebyshev_interval_days = 1.0
    
    # ✓ Adaptive timestep
    .use_adaptive_timestep = .TRUE.
    .coarse_timestep_hours = 6.0
    .fine_timestep_hours = 0.25  # Più fine per accuratezza

# ═══════════════════════════════════════════════════════════════
# CATALOGO GAIA DR3
# ═══════════════════════════════════════════════════════════════

gaia.
    .use_local_cache = .TRUE.
    .cache_directory = '/Users/michelebigi/catalogs'
    .catalog_file = 'gaia_mag18.cat.gz'
    .auto_download = .FALSE.  # Usa cache locale
    .version = 'DR3'
    
    # Filtri qualità stelle
    .min_parallax_over_error = 3.0
    .max_ruwe = 1.4  # Astrometria affidabile
    .min_visibility_periods_used = 8

# ═══════════════════════════════════════════════════════════════
# OUTPUT
# ═══════════════════════════════════════════════════════════════

output.
    .format = 'iota'  # Formato standard IOTA
    .directory = 'output_11234_validation'
    .include_uncertainties = .TRUE.
    .include_path = .TRUE.
    .include_timing = .TRUE.  # Include tempi calcolo per benchmark
    .generate_kml = .TRUE.
    .generate_json = .TRUE.
    
    # File aggiuntivi per validazione
    .save_ephemeris = .TRUE.  # Salva effemeride completa
    .ephemeris_file = 'ephemeris_11234.txt'

# ═══════════════════════════════════════════════════════════════
# FILTRI GEOGRAFICI - Italia + Europa
# ═══════════════════════════════════════════════════════════════

filters.
    .use_geographic_filter = .TRUE.
    
    # Bounding box: Italia + parte Europa per confronti
    .latitude_min = 35.0   # Sud Sicilia
    .latitude_max = 50.0   # Nord Germania
    .longitude_min = 5.0   # Ovest Francia
    .longitude_max = 20.0  # Est Europa
    
    # Parametri evento
    .max_distance_km = 5000.0  # Raggio da centro Italia
    .min_mag_drop = 0.3   # Minimo calo magnitudine
    .min_duration_sec = 0.05  # Eventi brevissimi OK

# ═══════════════════════════════════════════════════════════════
# DEBUG E VALIDAZIONE
# ═══════════════════════════════════════════════════════════════

debug.
    .verbose = .TRUE.  # Output dettagliato
    .log_file = 'italoccultcalc_11234_validation.log'
    .save_statistics = .TRUE.
    .statistics_file = 'statistics_11234.json'
    
    # Confronto con JPL Horizons (se disponibile)
    .compare_with_jpl = .TRUE.
    .jpl_comparison_epochs = '2025-09-21,2025-11-20,2026-01-19'

# ═══════════════════════════════════════════════════════════════
# PERFORMANCE
# ═══════════════════════════════════════════════════════════════

performance.
    .num_threads = 8  # OpenMP threads (auto-detect se 0)
    .enable_parallel_asteroids = .TRUE.
    .enable_parallel_stars = .TRUE.
    .cache_planet_positions = .TRUE.  # Cache posizioni planetarie

# ═══════════════════════════════════════════════════════════════
# NOTE OPERATIVE
# ═══════════════════════════════════════════════════════════════

# ASPETTATIVE:
#
# 1. Tempo calcolo:
#    - RKF78 con perturbazioni: ~0.05-0.1s per ±30 giorni
#    - 120 giorni totali: ~0.2s per l'asteroide
#    - Query Gaia: 1-5s (dipende da cache)
#    - TOTALE stimato: 5-10s per run completo
#
# 2. Accuratezza (vs JPL Horizons):
#    - ±30 giorni: < 1" (tipicamente 0.1-0.3")
#    - ±60 giorni: 1-3"
#    - ±90 giorni: 3-10"
#    - Molto meglio di RK4 senza perturbazioni (errori 10000-70000"!)
#
# 3. Fitting orbitale:
#    - RMS atteso: 0.3-0.5" (basato su 6844 osservazioni)
#    - Outlier: ~0.2% (12 su 6844)
#    - Convergenza: 10-20 iterazioni
#
# 4. Occultazioni previste:
#    - Dipende da traiettoria e densità stelle Gaia
#    - (11234) mag ~18-19: eventi rari ma possibili
#    - Stelle target: mag 10-16 (osservabili amatori)
#
# VALIDAZIONE:
#
# Confrontare risultati con JPL Horizons:
#   python3 compare_jpl_horizons.py
#
# Output atteso:
#   - Separazione angolare media < 3" a ±60gg
#   - Residui O-C < 0.5" RMS
#   - Nessun errore catastrofico di integrazione
#
# FILES GENERATI:
#   - output_11234_validation/occultations_*.txt (predizioni)
#   - ephemeris_11234.txt (effemeride completa per confronti)
#   - statistics_11234.json (statistiche calcolo)
#   - italoccultcalc_11234_validation.log (log dettagliato)
#
# ═══════════════════════════════════════════════════════════════
# Fine preset
# ═══════════════════════════════════════════════════════════════
