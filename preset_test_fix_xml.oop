! Test fix XML con pochi asteroidi
! Solo 3 asteroidi grandi

object.
        .id = '1'
        .name = '(1) Ceres'

time.
        .start_jd = 2460676.500000
        .end_jd = 2460681.500000        ! Solo 5 giorni
        .step_hours = 6.0

propag.
        .type = 'RA15'
        .step_size = 0.1
        .tolerance = 1.0E-12

perturbations.
        .planets = .TRUE.
        .relativity = .TRUE.
        .asteroid_count = 17

gaia.
        .version = 'DR3'
        .use_local_cache = .FALSE.      ! Usa query online
        .max_magnitude = 12.0

asteroid_db.
        .source = 'list'
        .asteroid_list = '1,2,4'       ! Ceres, Pallas, Vesta

search.
        .min_separation_arcsec = 0.1
        .max_separation_arcsec = 3.0
        .min_duration_sec = 0.5
        .start_jd = 2460676.500000
        .end_jd = 2460681.500000

observer.
        .name = 'Rome, Italy'
        .latitude = 41.9028
        .longitude = 12.4964
        .elevation = 0.0
