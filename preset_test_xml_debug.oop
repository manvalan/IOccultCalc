! Test minimo per debug XML

object.
        .id = '10'
        .name = '(10) Hygiea'

time.
        .start_jd = 2461015.5      ! 2025-12-06
        .end_jd = 2461017.5        ! 2025-12-08 (2 giorni)
        .step_hours = 6.0

propag.
        .type = 'RA15'
        .step_size = 0.1
        .tolerance = 1.0E-12

perturbations.
        .planets = .TRUE.
        .relativity = .TRUE.
        .asteroid_count = 17

gaia.
        .version = 'DR3'
        .use_local_cache = .FALSE.
        .max_magnitude = 12.0

search.
        .min_separation_arcsec = 0.01
        .max_separation_arcsec = 10.0
        .min_duration_sec = 0.01

output.
        .formats = 'xml'
