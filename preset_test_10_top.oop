! ITALOccultCalc - Preset test veloce 10 asteroidi top
! Michele Bigi - 2025-11-26

! ============================================================================
! PARAMETRI TEMPORALI
! ============================================================================
time.start_jd = 2461015.500000   ! 2025-12-06 12:00 UTC
time.end_jd = 2461025.500000     ! 2025-12-16 12:00 UTC (10 giorni)

! ============================================================================
! SELEZIONE ASTEROIDI
! ============================================================================
object.id = 'all'
asteroid_db.filter_by = 'H_magnitude'
asteroid_db.min_H = 3.0          ! Solo i più grandi
asteroid_db.max_H = 7.0          ! Top ~10 asteroidi
asteroid_db.use_local_database = true
asteroid_db.local_database_path = '~/.ioccultcalc/data/all_numbered_asteroids.json'

! ============================================================================
! PARAMETRI RICERCA
! ============================================================================
search.max_separation_arcsec = 10.0
search.min_probability = 0.01
search.magnitude_limit = 15.0

! ============================================================================
! GAIA
! ============================================================================
gaia.version = 'DR3'
gaia.use_cache = false
gaia.cache_dir = '~/.ioccultcalc/gaia/'

! ============================================================================
! PROPAGAZIONE
! ============================================================================
propagation.method = 'RA15'
propagation.step_size_days = 0.1
propagation.planetary_ephemeris = 'DE441'
propagation.include_perturbations = true
propagation.include_relativity = false

! ============================================================================
! OBJECT (required anche se usiamo all)
! ============================================================================
object.id = '1'
object.name = ''

! ============================================================================
! OUTPUT
! ============================================================================
output.formats = ['iota', 'json', 'xml']
output.directory = 'output'
output.prefix = 'test_10_asteroids'
