# Test minimale - Caricamento file .eq1 locale
# Solo verifica che IOccultCalc carichi correttamente il file

general.
    .propagator = 'RK4'
    .step_size_days = 0.1

time.
    .start_date = '2026-01-01'
    .end_date = '2026-01-02'
    .interval_days = 1.0

# ✅ TEST: Directory file locali
astdys.
    .local_eq1_directory = 'test_astdys_download'

asteroids.
    .selection_mode = 'manual'
    .asteroid_list = '433'

search.
    .max_magnitude = 15.0
    .search_radius_deg = 0.05

occultation.
    .use_chebyshev = .FALSE.

gaia.
    .use_local_cache = .FALSE.
    .version = 'DR3'

output.
    .format = 'text'
    .directory = 'output_test'
