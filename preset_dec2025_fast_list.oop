! TEST VELOCE - Dicembre 2025 - Lista Asteroidi 1-1000
! 31 giorni, Chebyshev degree 11, Gaia DR3 mag 13.0

time.start_jd = 2460674.500000
time.end_jd = 2460705.500000

object.id = '1'
object.name = 'First1000'

asteroid_db.filter_by = 'H_magnitude'
asteroid_db.min_H = 3.0
asteroid_db.max_H = 20.0
asteroid_db.use_local_database = false

search.max_separation_arcsec = 10.0
search.min_probability = 0.005
search.magnitude_limit = 13.0

gaia.version = 'DR3'
gaia.use_cache = true

propagation.method = 'RA15'
propagation.step_size_days = 0.1
propagation.planetary_ephemeris = 'DE441'
propagation.include_perturbations = true
propagation.include_relativity = false

output.formats = ['json']
output.directory = 'output'
output.prefix = 'dec2025_fast'

observer.name = 'Italy-Center'
observer.latitude = 42.8333
observer.longitude = 12.8333
observer.elevation_m = 100.0
