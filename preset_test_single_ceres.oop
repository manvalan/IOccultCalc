! Test XML con singolo asteroide - Ceres
! Dicembre 2025

object.
        .id = '1'
        .name = '(1) Ceres'

time.
        .start_jd = 2461015.500000      ! 2025-12-06
        .end_jd = 2461025.500000        ! 2025-12-16 (10 giorni)
        .step_hours = 6.0

propag.
        .type = 'RA15'
        .step_size = 0.1
        .tolerance = 1.0E-12

perturbations.
        .planets = .TRUE.
        .relativity = .TRUE.
        .asteroid_count = 17

gaia.
        .version = 'DR3'
        .use_local_cache = .FALSE.
        .max_magnitude = 14.0

search.
        .min_separation_arcsec = 0.001
        .max_separation_arcsec = 5.0
        .min_duration_sec = 0.01

output.
        .formats = 'xml'
