# IOccultCalc Preset - Uso Generale Bilanciato
# Configurazione equilibrata per la maggior parte dei casi d'uso

general.
    .propagator = 'hybrid'
    .step_size_days = 0.01
    .search_radius_deg = 1.0
    .precision_mode = 'balanced'
    .verbose = .FALSE.
    .parallel = .TRUE.
    .max_threads = 8

orbit_source.
    .type = 'astdys'
    .cache_expire_hours = 24
    .update_auto = .TRUE.

orbit_fitting.
    .mode = 'auto'  # Fitting intelligente
    .observations_source = 'astdys'
    .min_observations = 5
    .min_arc_days = 30
    .outlier_threshold = 3.0
    .max_iterations = 20
    .log_details = .FALSE.

asteroids.
    .selection_mode = 'list'
    .list = [433, 1, 2, 4, 10, 15, 16, 18, 29, 324, 704, 1036]
    .diameter_min = 1.0

time.
    .start_date = '2026-01-01'
    .end_date = '2026-12-31'
    .time_zone = 'UTC'

observer.
    .location_type = 'topocentric'
    .longitude = 11.2558    # Roma (modifica secondo necessità)
    .latitude = 41.9028
    .altitude = 50
    .name = 'Stazione di Osservazione'

search.
    .max_magnitude = 14.0
    .search_radius_deg = 0.05
    .min_probability = 0.05
    .min_duration_sec = 0.2
    .max_duration_sec = 300.0
    .min_drop_mag = 0.3
    .solar_elongation_min = 20.0
    .lunar_distance_min = 10.0
    .altitude_min = 20.0

star_catalogs.
    .primary = 'gaia_dr3'
    .secondary = 'gaia_dr2'
    .download_auto = .TRUE.
    .cache_size_gb = 15
    .proper_motion = .TRUE.
    .parallax_correction = .TRUE.

hybrid.
    .phase1_algorithm = 'chebyshev'
    .phase2_algorithm = 'astdyn'
    .promotion_threshold_arcsec = 60.0
    .convergence_tolerance_arcsec = 1.0
    .search_window_hours = 4.0
    .cache_phase1 = .TRUE.

astdyn.
    .tolerance = 1e-12
    .use_planets = .TRUE.
    .use_asteroids = .TRUE.
    .use_relativity = .TRUE.

chebyshev.
    .degree = 8
    .interval_days = 30
    .accuracy_target_arcsec = 0.1
    .cache_polynomials = .TRUE.

output.
    .format = 'json'
    .directory = './results/'
    .filename = 'occultazioni_2026'
    .include_header = .TRUE.
    .include_statistics = .TRUE.
    .include_fitting_info = .TRUE.
    .precision_coordinates = 2
    .precision_time = 1
    .sort_by = 'time'
    .filter_duplicates = .TRUE.
    .compression = 'none'

performance.
    .parallel_asteroids = .TRUE.
    .parallel_stars = .TRUE.
    .thread_pool_size = 12
    .memory_limit_gb = 8
    .cache_strategy = 'hybrid'
    .batch_size = 250
    .progress_update_percent = 10

debug.
    .log_level = 'info'
    .log_fitting = .FALSE.
    .log_performance = .FALSE.
    .validate_input = .TRUE.