! Test XML su 1000 asteroidi - Gennaio 2026

object.
        .id = 'all'

time.
        .start_jd = 2461015.500000      ! 2025-12-06
        .end_jd = 2461025.500000        ! 2025-12-16 (10 giorni)
        .step_hours = 6.0

propag.
        .type = 'RA15'
        .step_size = 0.1
        .tolerance = 1.0E-12

perturbations.
        .planets = .TRUE.
        .relativity = .TRUE.
        .asteroid_count = 17

gaia.
        .version = 'DR3'
        .use_local_cache = .TRUE.
        .cache_directory = '~/.ioccultcalc/gaia6'
        .max_magnitude = 14.0

asteroid_db.
        .source = 'MPCORB'
        .filter_by = 'H_magnitude'
        .min_H = 5.0
        .max_H = 12.0

search.
        .min_separation_arcsec = 0.001
        .max_separation_arcsec = 10.0
        .min_duration_sec = 0.01

output.
        .formats = 'xml'
